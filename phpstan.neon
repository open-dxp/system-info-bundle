parameters:
    level: 6
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
    scanFiles:
        - %currentWorkingDirectory%/vendor/open-dxp/opendxp/stubs/dynamic-constants.php
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        # The GUI lies below the Composer path, which only the running installation knows.
        - identifier: include.fileNotFound
          path: src/Controller/OpcacheController.php
    symfony:
        containerXmlPath: %currentWorkingDirectory%/var/cache/test/TestContainerDebug.xml
includes:
    - %currentWorkingDirectory%/vendor/phpstan/phpstan-symfony/extension.neon
    - phpstan-baseline.neon